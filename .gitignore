# Derived and reproducible - regenerated by the pipeline, never reviewed in a diff.
work/
output/
output_policies/

# Source documents and their transcriptions hold real policyholder data (named
# insureds, mailing addresses, policy numbers), so they stay out of the repo.
# Drop your own PDFs, schemas and golds into input_policies/ - discovery is
# folder-driven and needs no code change.
input/
input_policies/

# Third-party binaries and build artifacts.
runpodctl.exe
pod.tar.gz

# Python
__pycache__/
*.pyc
.venv/
